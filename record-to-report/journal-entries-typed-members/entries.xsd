<schema
   xmlns="http://www.w3.org/2001/XMLSchema"
   xmlns:entry="http://xbrlsite.com/je/entry"
   targetNamespace="http://xbrlsite.com/je/entry"
   elementFormDefault="qualified"
   attributeFormDefault="unqualified">

  <element name='EntryCode' id='entry_EntryCode'>
      <simpleType>
          <restriction base="string">
              <pattern value='JE[0-9][0-9][0-9]' />
          </restriction>
      </simpleType>
  </element>

</schema>
